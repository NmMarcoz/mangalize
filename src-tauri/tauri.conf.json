{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Mangalize",
  "version": "0.1.0",
  "identifier": "dev.mangalize.app",
  "build": {
    "beforeDevCommand": "bun run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "bun run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Mangalize",
        "width": 1440,
        "height": 920,
        "minWidth": 1040,
        "minHeight": 680,
        "dragDropEnabled": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/icon.png"]
  }
}
