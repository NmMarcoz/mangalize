<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Identical to the default on purpose. The app draws dark whatever the
         system is set to, so having a night variant at all would only be a
         second place for the window background to drift out of step. -->
    <style name="Theme.mangalize_app" parent="Theme.MaterialComponents.NoActionBar">
        <item name="android:windowBackground">@color/window_background</item>
    </style>
</resources>
