out/

# Generated by tauri-build from tauri.conf.json and the capabilities.
/src-tauri/gen/schemas

# The Android project is generated, but not entirely: `MainActivity.kt` and the
# manifest are ours to edit and `tauri android init` leaves them alone. Keeping
# the project means those edits survive a fresh checkout, and that CI can build
# an APK without reconstructing it first. Only the build output is ignored.
/src-tauri/gen/android/.gradle/
/src-tauri/gen/android/.idea/
/src-tauri/gen/android/build/
/src-tauri/gen/android/app/build/
/src-tauri/gen/android/app/src/main/jniLibs/
/src-tauri/gen/android/local.properties
/src-tauri/gen/apple
